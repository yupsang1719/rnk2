# --- Required in production -------------------------------------------------
# MongoDB connection string (e.g. from MongoDB Atlas).
MONGODB_URI=mongodb://127.0.0.1:27017/rnk2-properties
# Long random string used to sign CMS sign-in sessions (min 32 chars).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Optional ---------------------------------------------------------------
PORT=5000
# Only needed if the React dev server runs on a different origin.
CLIENT_ORIGIN=http://localhost:5173
# Where uploaded photos are stored. Must be a persistent disk in production.
# UPLOAD_DIR=/var/data/rnk2-uploads
# Number of reverse proxies in front of the app (for correct client IPs in rate limiting).
# TRUST_PROXY=1
